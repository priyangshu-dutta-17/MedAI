# ==============================================================================
# AI MEDICAL SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual secrets.
# NEVER commit the active .env file to source control.
# ==============================================================================

# Application Environment
FLASK_ENV=development
FLASK_APP=backend/app.py
PORT=5000
DEBUG=True
SECRET_KEY=replace_with_a_secure_random_flask_secret_key_32bytes

# Database Configuration (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_medical_system?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ai_medical_system
DB_NAME=ai_medical_system

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_jwt_secret_64bytes
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_ALGORITHM=HS256

# Google Maps Platform
# Enabled APIs: Maps JavaScript API, Places API, Geocoding API, Distance Matrix API
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here

# AI / Large Language Model Integration (Modular Assistant)
# Supports Gemini / OpenAI / Anthropic / HuggingFace via backend abstraction
AI_PROVIDER=gemini
AI_API_KEY=your_ai_assistant_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# CORS Configuration
# Allowed Frontend Origins (Comma separated)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Machine Learning Service Config
ML_MODELS_PATH=../ml/models
ML_CONFIDENCE_THRESHOLD=0.60
